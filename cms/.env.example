# ==========================================================================
# Strapi 5 CMS — environment template
# Copy to `.env` and fill in.  `.env` is gitignored (never commit real secrets).
# Generate secrets with:  openssl rand -base64 16
# ==========================================================================

# --- Server ---
HOST=0.0.0.0
PORT=1337
# Public URL Strapi is served from (used for admin + media absolute URLs in prod).
# Local: leave unset.  VPS: https://cms.<your-domain>
# URL=

# --- Secrets (REQUIRED — generate unique values per environment) ---
APP_KEYS="key1,key2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ==========================================================================
# Database
#   Local dev  -> sqlite  (zero config, file at .tmp/data.db)
#   VPS / prod -> postgres (set DATABASE_CLIENT=postgres + the block below)
# ==========================================================================
DATABASE_CLIENT=sqlite

# --- sqlite (local dev) ---
DATABASE_FILENAME=.tmp/data.db

# --- postgres (VPS / production) ---
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://strapi:password@localhost:5432/strapi
#   (DATABASE_URL takes precedence; or set the discrete vars below)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# DATABASE_SCHEMA=public

# ==========================================================================
# Media storage
#   Phase 0 default: local provider on the VPS disk (public/uploads).
#   Persists across restarts; back it up with the DB. Swap to S3-compatible
#   later (Phase 5/6) by installing @strapi/provider-upload-aws-s3 and
#   configuring config/plugins.ts + the vars below.
# ==========================================================================
# S3_ACCESS_KEY_ID=
# S3_ACCESS_SECRET=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
