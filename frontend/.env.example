# No sensitive credentials required for public medical library

# --- CMS (Strapi) integration ---
# Documented in Phase 0; NOT consumed by the frontend until Phase 3
# (data-access layer). Copy this file to .env.local and fill in.

# Base URL of the Strapi CMS (no trailing slash).
# Local dev:  http://localhost:1337
# Production: https://cms.<your-domain>
CMS_URL=http://localhost:1337

# Read-only API token minted in Strapi admin (Settings → API Tokens).
# Server-side only — never expose to the browser. Created in Phase 1.
CMS_API_TOKEN=
